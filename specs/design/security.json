{
  "version": 3,
  "permissions": [
    {
      "resource": "todos",
      "component": "todo-api",
      "description": "An End User's personal todos",
      "actions": [
        { "handle": "read", "description": "The caller's own todos" },
        { "handle": "manage", "description": "Create, update, and delete the caller's own todos" }
      ]
    }
  ],
  "groups": [],
  "roles": [
    {
      "name": "EndUser",
      "description": "Signs in and manages their own personal todo list.",
      "stories": [1, 2, 3, 4, 5, 6],
      "grants": ["todos:read", "todos:manage"],
      "enrolment": "self-service"
    }
  ],
  "testUsers": []
}
